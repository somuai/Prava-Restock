      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Formula: C_t = alpha * C_observed + (1 - alpha) * C_prev\n\u2022 Household consumption variance & order cadence tracking\n\u2022 Triggers replenishment when remaining stock <= 2 days",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Formula: C_t = alpha * C_observed + (1 - alpha) * C_prev\n\u2022 Household consumption variance & order cadence tracking\n\u2022 Triggers replenishment when remaining stock <= 2 days",
      "lineHeight": 1.25,
      "baseline": 9
